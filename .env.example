# Web3Forms access key — get one free at https://web3forms.com
# Copy this file to .env and paste your key:
#   VITE_WEB3FORMS_KEY=your-access-key-here
# While the key is empty, the contact form runs in demo mode (fake 700ms
# submit, shows success) so the site works without a key.
VITE_WEB3FORMS_KEY=